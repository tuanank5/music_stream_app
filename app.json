{
  "expo": {
    "name": "music_stream_app",
    "slug": "music-stream-app",
    "scheme": "musicstream",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
      "expo-image-picker",
        {
          "photosPermission": "Cho phép chọn ảnh bìa bài hát.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    } 
  }
}
