{
  "expo": {
    "name": "music_stream_app",
    "slug": "music-stream-app",
    "scheme": "musicstream",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép chọn ảnh bìa bài hát.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6a0c8f18-7519-44f0-8e5a-c7924edf1fdc"
      }
    },
    "android": {
      "package": "com.musicstreamapp"
    }
  }
}
