# Copy to .env.ai in repository root (already gitignored).
# Fill secrets locally; never commit .env.ai or paste its content into chat.
AI_ENABLED=true
GEMINI_API_KEY=replace-with-your-Gemini-key
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=768
AI_DAILY_REQUEST_LIMIT=100
GOOGLE_CLOUD_PROJECT=musicstreamapp-5a527
# LOCAL absolute path, NOT Render's /etc/secrets/... path.
# Prefer keeping the actual Firebase service-account JSON outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=C:/replace-with-local-path/firebase-admin-key.json
