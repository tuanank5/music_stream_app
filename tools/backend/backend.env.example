GOOGLE_CLOUD_PROJECT=replace-with-real-project-id
# Render Secret File; use a local absolute path when running outside Render.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-admin-key.json
CURSOR_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ALLOWED_ORIGINS=https://replace-with-your-web-app-origin
PORT=8080
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-server-api-key
CLOUDINARY_API_SECRET=replace-with-server-api-secret
# Server verifies audio duration/size via Cloudinary Admin API.
# Images also use signed uploads and Admin API verification; no client unsigned preset.
# imageAssets is an operational Firestore ledger. Include it in cloud backups.
# Cleanup defaults to read-only: npm run images:cleanup
# After reviewing dry-run/backup and pausing external writers:
# npm run images:cleanup -- --apply --maintenance
# Never prefix the server API secret with EXPO_PUBLIC_.
# Client cloud app also needs EXPO_PUBLIC_BACKEND_URL=https://your-backend-origin
# Use Application Default Credentials / workload identity on the server.
# Never put credentials or CURSOR_SECRET in EXPO_PUBLIC_* variables.

# Optional semantic search. Disabled until model access/quota is verified.
AI_ENABLED=false
GEMINI_API_KEY=
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=768
# Shared daily cap includes indexing and query embeddings; zero blocks API calls.
AI_DAILY_REQUEST_LIMIT=0
# Build the durable public index explicitly: npm run ai:index
# API keys stay on the backend. No LLM generation is used by semantic search.
